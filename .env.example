# Local deployment settings. Actual secrets belong in ignored .env only.
# Plant capabilities are versioned in app/plant-catalog.ts; research context is in PostgreSQL.
# See docs/configuration.md for configuration ownership and production secret handling.
APP_ENV=local
APP_URL=http://localhost:3100
DATABASE_URL=postgresql://celloras:CHANGE_ME@localhost:5434/celloras
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_ISSUER=http://localhost:8180/realms/celloras
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8180/realms/celloras
KEYCLOAK_CLIENT_ID=celloras
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
# agent:setup writes absolute local state/config paths and Compose profiles.
# Linux uses the official Docker gateway; --runtime=vm is optional Mac development.
# OPENSHELL_STATE_DIR=/absolute/private/path/openshell/state
# OPENSHELL_CONFIG_DIR=/absolute/private/path/openshell/worker-config
# CELLORAS_AGENT_METADATA_FILE=/absolute/private/path/openshell/agent-metadata.json
# COMPOSE_PROFILES=agent,agent-docker
# CELLORAS_WORKER_UID=1000
# CELLORAS_WORKER_GID=1000
# Runtime model/image/provider changes belong to the operator, never browser input.
CELLORAS_AGENT_IMAGE=celloras-codex:0.163.0-ui1
CELLORAS_AGENT_PROVIDER=celloras-codex
# Empty uses the authenticated Codex account's default model.
CELLORAS_AGENT_MODEL=
# Other scientific sponsor integrations remain pending. See docs/architecture.md.
