{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blocks"],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["markdown"]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "entryId"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "sample_context",
                  "marker_set",
                  "marker_evidence",
                  "lookup_marker_evidence",
                  "scientific_result",
                  "literature_result",
                  "annotation_result"
                ]
              },
              "entryId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "datasetId",
              "operation",
              "cluster",
              "genes",
              "query"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["run_scientific_tool"]
              },
              "datasetId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "inspect",
                  "markers",
                  "expression",
                  "dotplot",
                  "literature",
                  "annotation"
                ]
              },
              "cluster": {
                "type": ["string", "null"]
              },
              "genes": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string"
                }
              },
              "query": {
                "type": ["string", "null"]
              }
            }
          }
        ]
      }
    }
  }
}
