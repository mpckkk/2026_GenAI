{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blocks"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": { "type": "string", "enum": ["markdown"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 64000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "entryId"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["sample_context", "marker_set"]
              },
              "entryId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          }
        ]
      }
    }
  }
}
